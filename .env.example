# Copy this file to .env for production (npm start reads it automatically).
NODE_ENV=production
PORT=4000
# Required in production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# Optional: where the SQLite file lives (defaults to server/codegate.db)
# DATABASE_FILE=/var/lib/codegate/codegate.db
