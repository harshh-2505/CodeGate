# Copy this file to .env for production (npm start reads it automatically).
NODE_ENV=production
PORT=4000
# Required in production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
# Hosted libSQL database (Turso). Leave unset to use a local SQLite file.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
# Optional: local SQLite file path when Turso isn't used (defaults to server/codegate.db)
# DATABASE_FILE=/var/lib/codegate/codegate.db
